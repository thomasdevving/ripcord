{
  "name": "ripcord",
  "version": "0.1.0",
  "description": "Who holds privileged power over a DeFi contract, and how fast can they use it versus how fast you can leave.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ripcord": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ripcord": "tsx src/cli.ts",
    "render": "tsx scripts/render.ts calibration/reports site",
    "render:all": "tsx scripts/render.ts calibration/reports site --all",
    "verify:pages": "node scripts/verify-pages.mjs site calibration/reports",
    "calibrate:summary": "node scripts/summarize.mjs calibration/reports",
    "calibrate:blockers": "node scripts/manual-verification-audit.mjs calibration/reports",
    "determinism": "node scripts/compare-reports.mjs",
    "verify:claims": "node scripts/verify-claims.mjs",
    "live:fetch": "tsx scripts/fetch-live.ts",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "live:revalue": "tsx scripts/revalue-live.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build:webapp": "pnpm build:server && pnpm build:web",
    "start:webapp": "node dist-server/server/index.js",
    "dev:webapp": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"vite\"",
    "dev:server": "node scripts/dev-server.mjs",
    "verify:webapp": "node scripts/verify-webapp.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "commander": "^12.1.0",
    "fastify": "^5.12.1",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "concurrently": "^10.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.24.0"
}
