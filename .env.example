# Copy this file to .env and fill in a real RPC URL per chain.
# Never commit .env — it is gitignored.
#
# The AccessControl event-reconstruction path needs eth_getLogs over WIDE block
# ranges. NOTE: a paid tier is not automatically enough — a free Alchemy key
# (and public endpoints like blastapi) cap getLogs at ~10 blocks, and even
# Infura's 10k / Alchemy PAYG's 2k range leaves a deep-history contract as a
# labelled partial under the default request budget. `reconstruction.complete`
# is true only when the probed range covers the contract's whole history within
# the budget (~range >= history/750); otherwise Ripcord returns an explicitly
# labelled partial reconstruction, never a silent failure. For fast, single-pass,
# complete deep-history scans on the day-5 set, use an unbounded/large-range,
# un-rate-limited endpoint. The provider name (host only, never the key) is
# printed at the start of every scan.
#
# Determinism is provider-independent: every read is pinned to a block and
# cached by (chainId, block, method, params) — NOT by provider — so a warm
# cache built with one provider is a valid, identical hit for another.

RPC_URL_1=https://your-mainnet-rpc-provider.example/v2/YOUR_KEY

# --- Mobula (LIVE layer only — never touches the pinned verdict) -------------
# A key from https://admin.mobula.io. Optional for the pinned analyser because
# the live layer is optional; required when making fresh production Mobula calls.
#
# This key is read by src/live/* and live scripts ONLY. Nothing in the
# pinned path (cli.ts -> PinnedChain -> buildReport -> detect/*) reads it, and
# scripts/verify-boundary.mjs fails the build if that ever changes. A report is
# byte-identical whether or not this variable is set.
MOBULA_API_KEY=

# --- post-analysis asset context (LIVE layer, opt-in per analysis) -----------
# These refreshes start AFTER a job's worker exits, so RIPCORD_MAX_ACTIVE_JOBS
# cannot see them. Left unbounded they were one Mobula fetch and one anvil fork
# per completed job with no ceiling, and a stuck fork left a sidecar `pending`
# forever with every open browser tab polling it.
#
# Every limit below produces an explicit `unavailable` sidecar with a stated
# reason. None of them produces silence.
RIPCORD_MAX_ACTIVE_ASSET_CONTEXTS=1
RIPCORD_MAX_QUEUED_ASSET_CONTEXTS=4
RIPCORD_ASSET_CONTEXT_TIMEOUT_MS=900000

# --- instance identity (multi-replica deployments) --------------------------
# Stamped on every job ownership lease. Two things depend on it:
#
#   1. A restart reclaims its OWN previous life immediately. Without a stable
#      value each process gets a fresh random id, so a job left running by the
#      previous process is only reclaimed once its lease expires (~60s) by the
#      background reaper — correct, but slower than it needs to be.
#   2. Two replicas MUST have different values. Sharing one would let each treat
#      the other's live work as its own previous life and reclaim it.
#
# Leave unset for a single local instance; set it per replica in production.
# NOTE: durable ownership is enforced over a single shared volume (atomic
# temp+rename). It is not safe across NFS clients or separate volumes — see
# KNOWN EDGE #43.
# RIPCORD_INSTANCE_ID=replica-a
